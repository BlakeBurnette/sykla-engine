[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1

[libraries]
macos.debug = "res://bin/libsykla_godot.debug.dylib"
macos.release = "res://bin/libsykla_godot.release.dylib"
linux.debug.x86_64 = "res://bin/libsykla_godot.debug.so"
linux.release.x86_64 = "res://bin/libsykla_godot.release.so"
windows.debug.x86_64 = "res://bin/sykla_godot.debug.dll"
windows.release.x86_64 = "res://bin/sykla_godot.release.dll"
